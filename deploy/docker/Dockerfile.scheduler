# Build stage
FROM golang:1.23-alpine AS builder

WORKDIR /src
COPY go.mod ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=0.1.0" -o /bin/astra-scheduler ./cmd/astra-scheduler

# Minimal hardened distroless static runtime
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /
COPY --from=builder /bin/astra-scheduler /bin/astra-scheduler

USER 10001:10001
EXPOSE 8080 10259

ENTRYPOINT ["/bin/astra-scheduler"]
