# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit LF normalization for critical source types
*.go text eol=lf
*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf

